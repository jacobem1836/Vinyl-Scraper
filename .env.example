# --- Required in production ---------------------------------------------------
ENV=development                      # "production" enforces a real SECRET_KEY, https APP_URL and Secure cookies
SECRET_KEY=change-me                 # python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_URL=http://localhost:8000        # absolute base URL used in emails and links
DATABASE_URL=sqlite:///./vinyl.db    # PostgreSQL in production, e.g. postgresql://user:pass@host/db?sslmode=require

# --- Sources -----------------------------------------------------------------
DISCOGS_TOKEN=                       # discogs.com/settings/developers (required for Discogs results and typeahead)
EBAY_APP_ID=                         # developer.ebay.com Browse API client id (optional)
EBAY_CERT_ID=                        # ...and client secret

# --- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=                      # leave empty to log emails to stdout instead of sending
RESEND_FROM="CRATE <alerts@example.com>"

# --- Behaviour ----------------------------------------------------------------
SIGNUP_MODE=invite                   # "invite": waitlist + `python -m app.cli invite <email>`; "open": anyone can sign up
SCAN_INTERVAL_HOURS=6
SHIPPING_ESTIMATE_AUD=30             # used when a listing's origin country is unknown
RELEVANCE_THRESHOLD=70               # 0-100; listings whose title matches the query less than this are hidden
NOTIFY_COOLDOWN_HOURS=24
LEGACY_OWNER_EMAIL=                  # one-off: pre-auth wishlist rows are assigned to this account on first migrate
